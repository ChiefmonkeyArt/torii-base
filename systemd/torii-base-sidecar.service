[Unit]
Description=Torii base sidecar (registry + set-root API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=torii
Group=torii
WorkingDirectory=/opt/torii/sidecar
EnvironmentFile=/opt/torii/env
ExecStart=/usr/bin/node /opt/torii/sidecar/index.mjs
Restart=on-failure
RestartSec=5

# nginx -s reload needs to run as root; we grant just that via sudoers.
# See docs/sudoers-torii-nginx.
# The sidecar itself does `execFile('nginx', ...)`; we rely on nginx's suid
# behavior being off, so the sidecar's nginx reloads run through sudo -n.
# For simplicity in v0.1 we let the sidecar shell out directly; on a
# hardened box, wire a sudoers snippet and prefix nginx calls with sudo.
Environment=NODE_ENV=production

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/torii
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
