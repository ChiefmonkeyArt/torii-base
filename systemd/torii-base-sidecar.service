[Unit]
Description=Torii base sidecar (registry + set-root API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=torii
Group=torii
WorkingDirectory=/opt/torii/sidecar
EnvironmentFile=/opt/torii/env
ExecStart=/usr/bin/node /opt/torii/sidecar/index.mjs
Restart=on-failure
RestartSec=5

# The sidecar shells out to `sudo -n nginx -t` and `sudo -n nginx -s reload`
# to reload nginx after registering an app. bootstrap.sh installs a sudoers
# snippet at /etc/sudoers.d/torii-nginx that scopes this privilege to those
# two commands only. NoNewPrivileges must stay off (v0.1.1) because sudo
# requires setuid, which NoNewPrivileges forbids.
Environment=NODE_ENV=production

# Hardening (NoNewPrivileges intentionally omitted; see comment above)
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/torii
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
